# URL do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública anon/publishable — segura no navegador porque a RLS protege os dados
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role — SÓ para scripts locais (npm run seed, testes de RLS). NÃO cadastrar na Vercel
SUPABASE_SERVICE_ROLE_KEY=
# Connection string do Postgres (Settings > Database) — SÓ local, usada por npm run db:migrate. NÃO cadastrar na Vercel
DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Chave da OpenRouter — segredo do servidor (Vercel + .env.local)
OPENROUTER_API_KEY=
# Modelo usado pelo agente
OPENROUTER_MODEL=openai/gpt-6-luna
# URL pública do app (redirecionamentos de auth e links de convite)
NEXT_PUBLIC_APP_URL=http://localhost:3000
